# .env.example —— 密钥模板（spec 决策十）
#
# 复制为 .env 后填真实值；.env 已被 .gitignore 排除，绝不要提交真实密钥。

# LLM API Key（若 llm.command 走的是需要鉴权的 HTTP SDK / CLI，则从环境变量读取）
LLM_API_KEY=your-llm-api-key-here

# CapSolver 打码服务 API Key（决策六：验证码求解子步骤）
CAPSOLVER_API_KEY=your-capsolver-api-key-here

# 只读邮箱 IMAP 应用专用密码（用于自动取回注册验证码/验证链接，PRD 六）
IMAP_USERNAME=your-email@example.com
IMAP_PASSWORD=your-imap-app-specific-password-here
