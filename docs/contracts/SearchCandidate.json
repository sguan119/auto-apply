{
  "description": "A job after dedupe + gates (docs/search-spec.md §5). Shown in review.",
  "properties": {
    "platform": {
      "title": "Platform",
      "type": "string"
    },
    "job_id": {
      "title": "Job Id",
      "type": "string"
    },
    "url": {
      "format": "uri",
      "maxLength": 2083,
      "minLength": 1,
      "title": "Url",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "company": {
      "title": "Company",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Location"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "date_posted": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Posted"
    },
    "extracted_yoe": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extracted Yoe"
    },
    "yoe_is_preferred": {
      "default": false,
      "title": "Yoe Is Preferred",
      "type": "boolean"
    },
    "score": {
      "default": 0.0,
      "title": "Score",
      "type": "number"
    },
    "drop_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Drop Reason"
    },
    "prefilter_rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prefilter Rank"
    },
    "llm_keep": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Keep"
    },
    "llm_rank": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Rank"
    },
    "llm_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Llm Reason"
    },
    "selected": {
      "default": false,
      "title": "Selected",
      "type": "boolean"
    }
  },
  "required": [
    "platform",
    "job_id",
    "url",
    "title",
    "company"
  ],
  "title": "SearchCandidate",
  "type": "object"
}
