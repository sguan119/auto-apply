# === 敏感数据：绝不提交（对应 CLAUDE.md 关键约束）===
# 凭据 / 登录态
credentials.json
credentials/
*.credentials.json
secrets/
.env
.env.*
# 但密钥模板必须能提交（spec 决策十要求仓库提供 .env.example）
!.env.example

# 用户信息（bio）与个人简历
bio.json
bio/
resumes/
*.resume.pdf
cover-letters/

# 投递记录与运行日志（含填表内容，可能带个人信息）—— spec 决策九：data/、logs/、.env 绝不入仓库
data/
deliver-records/
logs/
*.log

# 用户本地真实配置：仓库只提交 config.example.toml 模板，用户复制成 config.toml 后本地维护
config.toml

# 真实投递任务清单（含具体职位 URL / 公司，属个人求职记录）：仓库只提交 tasks.example.json 模板
tasks*.json
!tasks.example.json

# Claude Code 本地个人设置
.claude/settings.local.json

# === 通用 ===
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# === Python ===
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
